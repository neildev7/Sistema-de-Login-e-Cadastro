<div class="cadastro-container">
    {{#if error}}
      <div class="error-msg">
        {{#if statusCode}}<strong>Erro {{statusCode}}:</strong> {{/if}}{{error}}
      </div>
    {{/if}}

    <h1>Cadastro</h1>

    <form action="/cadastro" method="POST" autocomplete="off">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        
        <div class="input-group">
            <input type="text" name="nome" placeholder="Nome de usuário" value="{{nome}}" required maxlength="{{maxNameLength}}">
        </div>

        <div class="input-group">
            <input type="email" name="email" placeholder="Email" value="{{email}}" required autocomplete="email">
        </div>

        <div class="input-group">
            <input type="password" name="senha" placeholder="Senha" required minlength="{{minPasswordLength}}" maxlength="{{maxPasswordLength}}" autocomplete="new-password">
        </div>

        <button type="submit">Cadastrar</button>
        
        <p class="links">Já tem uma conta? <a href="/login">Fazer Login</a></p>
    </form>
</div>

<footer class="footer">
    <p>Desenvolvido por Neil Lopes | 
       <a href="https://github.com/neildev7" target="_blank" rel="noopener noreferrer">GitHub</a>
    </p>
</footer>