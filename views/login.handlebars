<div class="login-container">
    {{#if error}}
      <div class="error-msg">
        {{#if statusCode}}<strong>Erro {{statusCode}}:</strong> {{/if}}{{error}}
      </div>
    {{/if}}

    <h1>Login</h1>

    <form action="/login" method="POST" autocomplete="off">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <div class="input-group">
            <input type="email" name="email" placeholder="Email" value="{{email}}" required autocomplete="email">
        </div>

        <div class="input-group">
            <input type="password" name="senha" placeholder="Senha" required minlength="{{minPasswordLength}}" maxlength="{{maxPasswordLength}}" autocomplete="current-password">
        </div>

        <button type="submit">Entrar</button>
        
        <div class="links">
            <p>Não tem uma conta? <a href="/cadastro">Cadastrar-se</a></p>
            <!-- Deixei o link de recuperar senha aqui caso você já tenha uma tela para isso -->
            <!-- <p><a href="/recuperar-senha">Esqueci minha senha</a></p> -->
        </div>
    </form>
</div>

<footer class="footer">
    <p>Desenvolvido por Neil Lopes | 
       <a href="https://github.com/neildev7" target="_blank" rel="noopener noreferrer">GitHub</a>
    </p>
</footer>