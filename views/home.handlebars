<div class="valorant-dashboard" data-page="home">
    
    <header class="dashboard-header">
        <div>
            <p>Acesso Autorizado</p>
            <h1>BEM-VINDO, <span>{{nome}}</span></h1>
        </div>
        <button id="logoutBtn" class="btn-secondary">Sair da conta</button>
    </header>

    <!-- SEÇÃO: Seleção de Agentes -->
    <section class="agent-selection">
        <h2 class="section-title">Defina seu Agente</h2>
        
        <div class="agent-grid">
            <!-- ATENÇÃO AQUI: Note o data-agent="" em cada um! -->
            <div class="agent-card" data-agent="jett">
                <img src="/img/jett.png" alt="Jett">
                <span>JETT</span>
            </div>
            <div class="agent-card" data-agent="reyna">
                <img src="/img/reyna.png" alt="Reyna">
                <span>REYNA</span>
            </div>
            <div class="agent-card" data-agent="phoenix">
                <img src="/img/phoniex.png" alt="Phoenix">
                <span>PHOENIX</span>
            </div>
            <div class="agent-card" data-agent="omen">
                <img src="/img/omen.png" alt="Omen">
                <span>OMEN</span>
            </div>
            <div class="agent-card" data-agent="sage">
                <img src="/img/sage.png" alt="Sage">
                <span>SAGE</span>
            </div>
            <div class="agent-card" data-agent="sova">
                <img src="/img/sova.png" alt="Sova">
                <span>SOVA</span>
            </div>
        </div>

        <!-- PAINEL DE INFORMAÇÕES (Fica invisível até clicar em alguém) -->
        <div id="agentInfoPanel" class="agent-info-panel" style="display: none;">
            <div class="agent-info-header">
                <h3 id="infoName">NOME</h3>
                <span id="infoRole" class="agent-role">Função</span>
            </div>
            <p id="infoDescription" class="agent-description">Descrição</p>
            
            <h4 class="abilities-title">Habilidades</h4>
            <ul id="infoAbilities" class="agent-abilities">
                <!-- Habilidades entram aqui automaticamente -->
            </ul>
        </div>
    </section>

    <!-- Configurações -->
    <section class="settings-panel">
        <div class="setting-card">
            <h3>Atualizar Identificação</h3>
            <div class="input-row">
                <input type="text" id="novoNome" placeholder="Novo nome" maxlength="80">
                <button id="atualizarNomeBtn" class="btn-primary">Atualizar</button>
            </div>
            <p id="msgNome" class="msg-feedback"></p>
        </div>

        <div class="setting-card">
            <h3>Credenciais de Acesso</h3>
            <div class="input-row">
                <input type="password" id="novaSenhaUsuario" placeholder="Nova senha" minlength="8" maxlength="72" autocomplete="new-password">
                <button id="atualizarSenhaBtn" class="btn-primary">Alterar</button>
            </div>
            <p id="msgSenha" class="msg-feedback"></p>
        </div>

        <div class="danger-zone">
            <h3>Zona de Risco</h3>
            <p>A exclusão da conta é permanente e removerá seu acesso ao painel.</p>
            <button id="excluirContaBtn" class="btn-danger">Excluir minha conta</button>
        </div>
    </section>

</div>

<footer class="footer">
    <p>
        Desenvolvido por Neil Lopes |
        <a href="https://github.com/neildev7" target="_blank" rel="noopener noreferrer">GitHub</a>
    </p>
</footer>

