<div class="home-container" data-page="home">
  <h1>Parabéns, {{nome}} 👋</h1>
  <p>Você passou do login com sucesso!</p>

  <button id="logoutBtn" class="space-bottom">Sair da conta</button>

  <hr>
  <h3>Atualizar nome</h3>
  <input type="text" id="novoNome" placeholder="Novo nome" maxlength="80">
  <button id="atualizarNomeBtn">Atualizar</button>

  <p id="msgNome"></p>

  <hr>

  <h3>Alterar senha</h3>
  <input type="password" id="novaSenhaUsuario" placeholder="Nova senha" minlength="8" maxlength="72" autocomplete="new-password">
  <button id="atualizarSenhaBtn">Alterar senha</button>
  <p id="msgSenha"></p>

  <hr>

  <h3>Excluir conta</h3>
  <button id="excluirContaBtn" class="danger-button">
    Excluir minha conta
  </button>
</div>

<footer class="footer">
  <p>
    Desenvolvido por Neil Lopes |
    <a href="https://github.com/neildev7" target="_blank" rel="noopener noreferrer">GitHub</a>
  </p>
</footer>
